{
  "include": ["assets/js/**/*.ts", "assets/js/**/*.js"],
  "exclude": ["node_modules", "vendor", "demo"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "*": ["*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    // TODO - Remove this skip once we have types from phoenix:
    // - https://github.com/phoenixframework/phoenix/pull/6364
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom", "dom.iterable"]
  }
}
